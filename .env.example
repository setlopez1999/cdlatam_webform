# ─────────────────────────────────────────────
#  ENTORNO
# ─────────────────────────────────────────────
NODE_ENV=production

# ─────────────────────────────────────────────
#  BASE DE DATOS (SQLite)
# ─────────────────────────────────────────────
# Ruta al archivo SQLite dentro del contenedor Docker
DATABASE_URL=file:/app/data/gestion.db

# ─────────────────────────────────────────────
#  SEGURIDAD — IMPORTANTE
# ─────────────────────────────────────────────
# Generá secrets seguros con: openssl rand -hex 32
# Mínimo 32 caracteres cada uno.

# Clave para firmar los JWT de sesión
JWT_SECRET=cambia_esto_por_un_secreto_de_32_caracteres_o_mas

# Clave para firmar las cookies de sesión
COOKIE_SECRET=cambia_esto_por_otro_secreto_de_32_caracteres_o_mas

# ─────────────────────────────────────────────
#  USUARIOS POR DEFECTO (opcional)
# ─────────────────────────────────────────────
# Si no se definen, se generan contraseñas aleatorias de 20 chars
# en el primer inicio y se muestran en consola.
# DEFAULT_ADMIN_PASSWORD=mi_password_admin_seguro
# DEFAULT_USER_PASSWORD=mi_password_usuario_seguro

# ─────────────────────────────────────────────
#  FUENTE DE DATOS
# ─────────────────────────────────────────────
# false → usa SQLite (por defecto)
# true  → usa la API externa definida en API_URL
USE_API=false

# URL base de la API externa (solo si USE_API=true)
# Ejemplo: https://api.tu-dominio.com
API_URL=

# ─────────────────────────────────────────────
#  DEBUG
# ─────────────────────────────────────────────
# true  → imprime en consola cada llamada a dataSource
# false → silencioso (recomendado en producción)
DEBUG=false
