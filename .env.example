# ═══════════════════════════════════════════════════════════════════════════════
#  SGA CDLatam — Variables de Entorno
#  Copia este archivo como .env y completa los valores reales.
#
#  NUNCA subas el .env real al repositorio.
#  El .env.example es la plantilla pública (sin secrets reales).
# ═══════════════════════════════════════════════════════════════════════════════

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=production
# production | development

# ── Base de datos ─────────────────────────────────────────────────────────────
# PostgreSQL (producción en VPS con Docker):
DATABASE_URL=postgresql://sga_user:TU_PASSWORD_POSTGRES@postgres:5432/sga_db

# SQLite (desarrollo local sin Docker):
# DATABASE_URL=file:./gestion.db

# ── PostgreSQL (solo para docker-compose) ─────────────────────────────────────
# Estas variables las usa el contenedor postgres para crear la BD en el primer arranque.
# Deben coincidir con los datos en DATABASE_URL.
POSTGRES_USER=sga_user
POSTGRES_PASSWORD=TU_PASSWORD_POSTGRES_SEGURO
POSTGRES_DB=sga_db

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Genera secrets seguros con: openssl rand -hex 32
# Mínimo 32 caracteres. NUNCA uses los valores de ejemplo en producción.

# Clave para firmar los JWT de sesión de usuario
JWT_SECRET=GENERA_CON_openssl_rand_hex_32

# Clave para firmar las cookies de sesión
COOKIE_SECRET=GENERA_CON_openssl_rand_hex_32

# ── Usuarios por defecto ──────────────────────────────────────────────────────
# Si no se definen, se generan contraseñas aleatorias en el primer inicio
# y se imprimen en los logs del contenedor (docker logs sga_app).
# CAMBIAR INMEDIATAMENTE después del primer login.
DEFAULT_ADMIN_PASSWORD=cambia_esto_urgente_minimo_12_chars
DEFAULT_USER_PASSWORD=cambia_esto_urgente_minimo_12_chars

# ── Fuente de datos ───────────────────────────────────────────────────────────
# false → usa la BD local (PostgreSQL o SQLite según DATABASE_URL)
# true  → usa la API externa definida en API_URL
USE_API=false

# URL base de la API externa (solo si USE_API=true)
API_URL=

# ── Debug ─────────────────────────────────────────────────────────────────────
# true  → imprime en consola cada llamada a dataSource (verbose)
# false → silencioso (recomendado en producción)
DEBUG=false
